# Copy to .env (or .env.local) and fill in real values. See AIRTABLE_SCHEMA.md.

# Telegram MTProto credentials (from https://my.telegram.org) and bot token.
API_ID=
API_HASH=
BOT_TOKEN=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Optional: sterilization base for cat-flat notifications (leave empty to disable).
AIRTABLE_STERILIZATION_BASE_ID=

# Shown in /help. CI sets this from the git tag.
VERSION=local

# Optional: Telethon session file name (without extension). Defaults to "ololo".
# Override to run a second instance without sharing the session file.
# SESSION_NAME=ololo
